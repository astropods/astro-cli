# astro-otel — OTLP ingest for local AI coding tools (Claude Code, Codex).
#
# Copy to .env and fill in. Loaded automatically at startup via godotenv, the
# same as astro-server and astro-registry. Deployed environments pass these as
# real env vars and have no .env.
#
# Run with:
#   moon run astro-otel:build && ./bin/astro-otel
#
# Then point a coding tool at http://localhost:4318 with an account ingest key
# (Settings -> Data Sources in astro-client mints one and prints the block).

# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------

# astro-server's Postgres — the SAME database astro-server uses. Read for
# otel_ingest_tokens (key -> account) and account_langfuse (per-account trace
# credentials); the only write is stamping last_used_at on a key.
# Copy the value from apps/astro-server/.env.
DATABASE_URL=

# At least one of the two endpoints below must be set, or startup fails.

# ---------------------------------------------------------------------------
# Traces -> Langfuse
# ---------------------------------------------------------------------------

# Base OTLP URL of the Langfuse instance. Traces are POSTed to <base>/v1/traces
# with per-account Basic auth resolved from account_langfuse. Prompt/response
# content rides the logs signal and is transformed into spans against the same
# endpoint.
#
# This is LANGFUSE_BASE_URL + /api/public/otel — the same path the agent
# collector uses. For a personal dev cluster that is:
#   https://langfuse.<you>.dev.astropod.ai/api/public/otel
LANGFUSE_OTLP_ENDPOINT=

# ---------------------------------------------------------------------------
# Metrics -> VictoriaMetrics
# ---------------------------------------------------------------------------

# Native OTLP push URL for metrics. astro-otel POSTs to <base>/v1/metrics with
# no auth, relying on network isolation.
#
# Metrics carry cost and token counts and no prompt content. Insights sources
# all dev-tool spend from here, and the Claude Code row only appears in the
# agents table when this data exists — so leaving it unset means no dev-tool
# surface at all, even though traces still flow.
#
# Note for personal dev clusters: PROMETHEUS_URL there is real Prometheus with
# --web.enable-otlp-receiver disabled, so it cannot accept OTLP as configured.
# Either have that flag enabled (then use <PROMETHEUS_URL>/api/v1/otlp) or run
# VictoriaMetrics locally:
#   docker run -d -p 8428:8428 victoriametrics/victoria-metrics
#   VM_OTLP_ENDPOINT=http://localhost:8428/opentelemetry
# and point astro-server's PROMETHEUS_URL at http://localhost:8428 to read it
# back.
VM_OTLP_ENDPOINT=

# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------

# Listen address. 4318 is the OTLP/HTTP convention and what coding tools expect.
PORT=4318
HOST=0.0.0.0

# How long a validated key -> account lookup is cached. Also the upper bound on
# how long a revoked key keeps working.
TOKEN_CACHE_TTL=60s

# Strip prompt/completion/tool-body attributes before forwarding. Off by
# default; managed settings already gate that content at the source, so this is
# belt-and-braces. Turning it on leaves nothing for prompt classification to
# read.
OTEL_REDACT_ATTRIBUTES=false
