# Astro Registry Configuration

# ===========================================
# Required
# ===========================================

REGISTRY_URL=                       # ECR URL, e.g. https://123456789.dkr.ecr.us-east-1.amazonaws.com
WORKOS_CLIENT_ID=                   # WorkOS client ID for JWT audience validation
REGISTRY_TOKEN_REALM=               # Public URL of /token, e.g. https://registry.astro.example.com/token

# ===========================================
# Optional (defaults shown)
# ===========================================

# Server
PORT=5000
HOST=0.0.0.0
GIN_MODE=release                    # debug | release | test
READ_TIMEOUT=30s
WRITE_TIMEOUT=30s
SHUTDOWN_TIMEOUT=30s

# Logging
LOG_LEVEL=info                      # debug | info | warn | error
LOG_FORMAT=text                     # text | json

# Security
ALLOWED_ORIGINS=*                   # comma-separated
TRUSTED_PROXIES=                    # comma-separated

# Registry
AWS_REGION=                         # AWS region for ECR auth, e.g. us-east-1

# Authentication
# JWKS_ENDPOINT and JWT_ISSUER are auto-constructed from WORKOS_CLIENT_ID if not set
# JWKS_ENDPOINT=https://api.workos.com/sso/jwks/{client_id}
# JWT_ISSUER=https://api.workos.com/user_management/{client_id}
