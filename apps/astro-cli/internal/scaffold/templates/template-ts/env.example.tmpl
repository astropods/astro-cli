# {{.Name}} Environment Variables
# Update the values below as needed
{{- range .Integrations}}
{{- if eq . "anthropic"}}

# Anthropic API Key
ANTHROPIC_API_KEY={{with $.IntegrationKey "anthropic"}}{{.}}{{else}}your-api-key-here{{end}}
{{- else if eq . "openai"}}

# OpenAI API Key
OPENAI_API_KEY={{with $.IntegrationKey "openai"}}{{.}}{{else}}your-api-key-here{{end}}
{{- else if eq . "github"}}

# GitHub Integration
GITHUB_TOKEN={{with $.IntegrationKey "github"}}{{.}}{{else}}your-github-token-here{{end}}
{{- end}}
{{- end}}
{{- range .Interfaces}}
{{- if eq . "slack"}}

# Slack Integration
SLACK_BOT_TOKEN={{with $.IntegrationKey "slack_bot_token"}}{{.}}{{else}}xoxb-your-bot-token{{end}}
SLACK_APP_TOKEN={{with $.IntegrationKey "slack_app_token"}}{{.}}{{else}}xapp-your-app-token{{end}}
{{- end}}
{{- end}}
