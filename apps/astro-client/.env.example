# Backend API URL
#
# For local backend development:
#   VITE_API_URL=http://localhost:8080
#
# For remote backend development (run `npm run setup` first):
#   VITE_API_URL=https://example.com
#
VITE_API_URL=http://localhost:8080

# CDN base URL for static assets (integration icons, avatars, etc.)
# Defaults to "" (served locally by Vite dev server from repo root assets/).
# Preview:  VITE_ASSETS_URL=https://assets.astropod.ai
# Prod:     VITE_ASSETS_URL=https://assets.astropods.ai
# VITE_ASSETS_URL=

# Amplitude analytics (optional — omit to disable telemetry in dev)
# VITE_AMPLITUDE_API_KEY=your_amplitude_api_key