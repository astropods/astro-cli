# Server Configuration
PORT=8080
HOST=0.0.0.0
GIN_MODE=debug
READ_TIMEOUT=10s
WRITE_TIMEOUT=10s
SHUTDOWN_TIMEOUT=30s

# Logging Configuration
LOG_LEVEL=info
LOG_FORMAT=json

# Security Configuration
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
TRUSTED_PROXIES=

# Deployment Configuration
ARTIFACT_DIR=/tmp/astro-artifacts
REGISTRY_URL=123456789.dkr.ecr.us-east-1.amazonaws.com
K8S_KUBECONFIG_PATH=
K8S_IN_CLUSTER=false
K8S_MASTER_URL=

# WorkOS Authentication Configuration
# Get these from your WorkOS dashboard: https://dashboard.workos.com
AUTH_ENABLED=true
WORKOS_API_KEY=sk_test_your_api_key_here
WORKOS_CLIENT_ID=client_your_client_id_here
WORKOS_REDIRECT_URI=http://localhost:8080/auth/callback

# Frontend URL for redirects after auth
FRONTEND_URL=http://localhost:5173

# Session/Cookie Configuration
# Cookie password must be at least 32 characters for secure encryption
AUTH_COOKIE_NAME=astro_session
AUTH_COOKIE_PASSWORD=your-super-secret-cookie-password-min-32-chars
AUTH_COOKIE_DOMAIN=
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_MAX_AGE=168h
AUTH_SESSION_MAX_AGE=24h

# JWT Configuration
AUTH_JWT_ISSUER=https://api.workos.com
