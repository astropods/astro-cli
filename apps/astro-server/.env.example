# Local development configuration for astro-server
# Usage: cp .env.example .env && go run main.go
#
# Setup:
#   1. Docker Desktop with Kubernetes enabled (Settings > Kubernetes > Enable
#   2. Start with moon run astro-server:dev

# Database
DATABASE_URL=postgres://postgres:postgres@localhost:5432/astro?sslmode=disable

# Kubernetes: use local kubeconfig instead of EKS/IRSA
K8S_CLIENT_MODE=local
KUBE_CONTEXT=docker-desktop
REGISTRY_URL=docker.io/library
ENVIRONMENT=local

# Auth — use stage WorkOS credentials for local dev
WORKOS_API_KEY=sk_test_...
WORKOS_CLIENT_ID=client_...
AUTH_COOKIE_PASSWORD=VTDXE7UIxD3+54UxkX1yl7SQNVXp3/j4PH69va/tEuE=

# Server
PORT=8080
ADMIN_GRPC_PORT=9091
GIN_MODE=release
LOG_LEVEL=debug
SERVER_MODE=api

# OpenMeter — use fake server for local dev (started by dev.sh)
OPENMETER_URL=http://localhost:8888

# Loki — use Adhoc Loki for local dev
LOKI_URL=https://loki.adhoc.dev.astropod.ai

# Prometheus — use Adhoc Prometheus for local dev
PROMETHEUS_URL=https://prometheus.adhoc.dev.astropod.ai

# Langfuse — observability backend for agent traces
LANGFUSE_BASE_URL=https://langfuse.adhoc.dev.astropod.ai
# LANGFUSE_BASE_URL_EXT — external Langfuse URL passed to collector (overrides LANGFUSE_BASE_URL when set)
# LANGFUSE_BASE_URL_EXT=https://langfuse.ext.astropod.ai
# LANGFUSE_VPCE_IPS — comma-separated VPC endpoint IPs for Langfuse PrivateLink (added to NetworkPolicy egress)
# LANGFUSE_VPCE_IPS=10.3.11.50,10.3.12.50
LANGFUSE_DB_URL=postgres://...
LANGFUSE_SALT=...
LANGFUSE_ORG_ID=astro

# GitHub repo connection — automated builds
# GITHUB_CALLBACK_URL — public base URL for OAuth callbacks and webhook delivery.
# Use an ngrok tunnel in local dev: ngrok http 8080, then set to https://xxx.ngrok-free.app
# Falls back to FRONTEND_URL if not set.
# GITHUB_CALLBACK_URL=https://xxx.ngrok-free.app
