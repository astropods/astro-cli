# =============================================================================
# REQUIRED CONFIGURATION
# =============================================================================

# Database - PostgreSQL connection string
DATABASE_URL=postgres://user:password@localhost:5432/astro?sslmode=disable

# ECR Registry - AWS ECR URL for container images
REGISTRY_URL=123456789.dkr.ecr.us-east-1.amazonaws.com

# EKS Cluster - Kubernetes cluster configuration
EKS_CLUSTER_NAME=my-eks-cluster
K8S_MASTER_URL=https://xxx.eks.amazonaws.com
AWS_REGION=us-east-1

# WorkOS Authentication - Get credentials from https://dashboard.workos.com
WORKOS_API_KEY=sk_test_your_api_key_here
WORKOS_CLIENT_ID=client_your_client_id_here

# Cookie Encryption - Must be at least 32 characters
AUTH_COOKIE_PASSWORD=your-super-secret-cookie-password-min-32-chars

# =============================================================================
# OPTIONAL CONFIGURATION (Has defaults)
# =============================================================================

# Server
PORT=8080
GIN_MODE=release

# Logging
LOG_LEVEL=info
LOG_FORMAT=json

# Proxy Registry - Registry proxy host for image resolution
PROXY_REGISTRY_HOST=registry.odesdaz.com

# Authentication URLs
WORKOS_REDIRECT_URI=http://localhost:8080/auth/callback
FRONTEND_URL=http://localhost:5173

# Admin API (Basic Auth) - Set ADMIN_ENABLED=false to disable
ADMIN_ENABLED=true
ADMIN_BASIC_USER=admin
ADMIN_BASIC_PASSWORD=change-me-in-production

# CORS
ALLOWED_ORIGINS=*

# Static Files (Frontend) - Leave empty to disable
STATIC_DIR=
