# Database
DATABASE_URL=postgres://postgres:postgres@localhost:5432/astro?sslmode=disable

# Kubernetes - "local" for dev (Docker Desktop/kind/minikube), "eks" for production
K8S_CLIENT_MODE=local
KUBE_CONTEXT=docker-desktop
REGISTRY_URL=docker.io/library

# EKS - Required when K8S_CLIENT_MODE=eks
# EKS_CLUSTER_NAME=my-eks-cluster
# K8S_MASTER_URL=https://xxx.eks.amazonaws.com
# AWS_REGION=us-east-1
# REGISTRY_URL=123456789.dkr.ecr.us-east-1.amazonaws.com

# Auth - Disabled by default for local dev
AUTH_ENABLED=false
# WORKOS_API_KEY=sk_test_...
# WORKOS_CLIENT_ID=client_...
# AUTH_COOKIE_PASSWORD=your-super-secret-cookie-password-min-32-chars

# Admin - Disabled by default for local dev
ADMIN_ENABLED=false
# ADMIN_BASIC_USER=admin
# ADMIN_BASIC_PASSWORD=change-me-in-production

# Server
PORT=4321
GIN_MODE=debug
LOG_LEVEL=debug
