{
    "info": {
        "name": "Webhook Ingestion",
        "description": "Endpoints for the webhook ingestion server.",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
    },
    "variable": [
        {
            "key": "baseUrl",
            "value": "http://localhost:3001"
        }
    ],
    "item": [
        {
            "name": "Health",
            "request": {
                "method": "GET",
                "header": [],
                "url": "{{baseUrl}}/health",
                "description": "Health check endpoint."
            }
        },
        {
            "name": "Send webhook",
            "request": {
                "method": "POST",
                "header": [
                    {
                        "key": "Content-Type",
                        "value": "application/json"
                    }
                ],
                "body": {
                    "mode": "raw",
                    "raw": "{\n  \"event\": \"example\",\n  \"data\": {}\n}"
                },
                "url": "{{baseUrl}}/webhook",
                "description": "Send a webhook payload to be ingested into knowledge stores."
            }
        }
    ]
}
