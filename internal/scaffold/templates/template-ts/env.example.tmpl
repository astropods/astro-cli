# {{.Name}} Environment Variables
# Update the values below as needed
{{- if eq .Model "anthropic"}}

# Anthropic API Key
ANTHROPIC_API_KEY={{if .ModelApiKey}}{{.ModelApiKey}}{{else}}your-api-key-here{{end}}
{{- end}}
{{- if eq .Model "openai"}}

# OpenAI API Key
OPENAI_API_KEY={{if .ModelApiKey}}{{.ModelApiKey}}{{else}}your-api-key-here{{end}}
{{- end}}
{{- range .Integrations}}
{{- if eq . "github"}}

# GitHub Integration
GITHUB_TOKEN=your-github-token-here
{{- end}}
{{- end}}
{{- range .Interfaces}}
{{- if eq . "slack"}}

# Slack Integration
SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_APP_TOKEN=xapp-your-app-token
{{- end}}
{{- end}}
