# syntax=docker/dockerfile:1

# Stage 1: Build
FROM oven/bun:1 AS builder
WORKDIR /app

# Copy package files
COPY packages/astro-playground-web/package.json ./

# Install dependencies
RUN bun install

# Copy source files
COPY packages/astro-playground-web/ ./

# Build the application
RUN bun run build

# Stage 2: Serve
FROM nginx:alpine

# Copy built files
COPY --from=builder /app/dist /usr/share/nginx/html

# Copy nginx config template (entrypoint substitutes BACKEND_URL at runtime)
COPY packages/astro-playground-web/nginx.conf.template /etc/nginx/nginx.conf.template

# Copy env-config template and entrypoint script
COPY packages/astro-playground-web/env-config.template.js /usr/share/nginx/html/env-config.template.js
COPY packages/astro-playground-web/docker-entrypoint.sh /docker-entrypoint.sh
RUN chmod +x /docker-entrypoint.sh && \
    chown -R nginx:nginx /usr/share/nginx/html && \
    chown -R nginx:nginx /etc/nginx/conf.d && \
    chown -R nginx:nginx /var/cache/nginx && \
    chown -R nginx:nginx /var/log/nginx && \
    touch /var/run/nginx.pid && chown nginx:nginx /var/run/nginx.pid

USER nginx

EXPOSE 80

ENTRYPOINT ["/docker-entrypoint.sh"]
CMD ["nginx", "-g", "daemon off;"]
