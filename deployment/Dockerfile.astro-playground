# Stage 1: Build
FROM node:20-alpine AS builder
WORKDIR /app

# Copy package files
COPY packages/astro-playground-web/package.json ./

# Install dependencies
RUN npm install

# Copy source files
COPY packages/astro-playground-web/ ./

# Build the application
RUN npm run build

# Stage 2: Serve
FROM nginx:alpine

# Copy built files
COPY --from=builder /app/dist /usr/share/nginx/html

# Copy nginx configuration
COPY packages/astro-playground-web/nginx.conf /etc/nginx/conf.d/default.conf

# Copy env-config template and entrypoint script
COPY packages/astro-playground-web/env-config.template.js /usr/share/nginx/html/env-config.template.js
COPY packages/astro-playground-web/docker-entrypoint.sh /docker-entrypoint.sh
RUN chmod +x /docker-entrypoint.sh

EXPOSE 80

ENTRYPOINT ["/docker-entrypoint.sh"]
CMD ["nginx", "-g", "daemon off;"]
