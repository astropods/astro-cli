# config/preview.env
# Non-secret environment variables for preview
# These are deployed as a Kubernetes ConfigMap
# For sensitive information, store them in the 1Password Astro Vault
LOG_LEVEL=debug
ALLOWED_ORIGINS=https://local.astropod.ai:5173,https://astropod.ai
MIN_CLI_VERSION=0.3.7
# Billing gating is on in preview only: an account that spends its free credit
# without a card is stopped and notified. Quota enforcement stays off; it is a
# separate resource limit, not a billing one.
BILLING_PROVIDER=metronome
QUOTA_ENFORCE=false
BILLING_GATE_ENFORCE=true

METRONOME_PACKAGE_ID=2d16c5d0-07cd-42f6-984b-5928400cd163
METRONOME_CREDIT_TYPE_ID=2714e483-4ff1-48e4-9e25-ac732e8f24f2
METRONOME_SIGNUP_CREDIT=10
METRONOME_CREDIT_EXPIRY_DAYS=365

# Preview bills against Metronome's sandbox environment. Admin deep links carry
# it as a path segment; without it they land in the default environment and
# report no such customer.
METRONOME_DASHBOARD_ENV=sandbox


# Messaging OIDC configuration for preview environment
MESSAGING_OIDC_ISSUER=https://calm-muffin-21-staging.authkit.app
MESSAGING_OIDC_AUTH_ENDPOINT=https://calm-muffin-21-staging.authkit.app/oauth2/authorize
MESSAGING_OIDC_TOKEN_ENDPOINT=https://calm-muffin-21-staging.authkit.app/oauth2/token
MESSAGING_OIDC_USERINFO_ENDPOINT=https://calm-muffin-21-staging.authkit.app/oauth2/userinfo


# Novu configuration
NOVU_API_URL=https://api.novu.astroids.ai
NOVU_SOCKET_URL=https://ws.novu.astroids.ai
NOVU_APP_IDENTIFIER=LQDqPHSuds9H
NOVU_TEST_WORKFLOW_ID=system.test
