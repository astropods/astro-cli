# config/prod.env
# Non-secret environment variables for production
# These are deployed as a Kubernetes ConfigMap
# For sensitive information, store them in the 1Password Astro Vault
LOG_LEVEL=info
ALLOWED_ORIGINS=https://local.astropods.ai:5173,https://astropods.ai
MIN_CLI_VERSION=0.7.2
OPENMETER_DEFAULT_PLAN=private_beta
OPENMETER_ENFORCE=true

# Messaging OIDC configuration for preview environment
MESSAGING_OIDC_ISSUER=https://login.astropods.ai
MESSAGING_OIDC_AUTH_ENDPOINT=https://login.astropods.ai/oauth2/authorize
MESSAGING_OIDC_TOKEN_ENDPOINT=https://login.astropods.ai/oauth2/token
MESSAGING_OIDC_USERINFO_ENDPOINT=https://login.astropods.ai/oauth2/userinfo