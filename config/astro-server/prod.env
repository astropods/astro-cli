# config/prod.env
# Non-secret environment variables for production
# These are deployed as a Kubernetes ConfigMap
# For sensitive information, store them in the 1Password Astro Vault
LOG_LEVEL=info
ALLOWED_ORIGINS=https://local.astropods.ai:5173,https://astropods.com
MIN_CLI_VERSION=0.7.2
# Metronome migration: no-op billing provider while we cut over. Quota
# enforcement is disabled so early users don't hit resource limits right away.
BILLING_PROVIDER=noop
QUOTA_ENFORCE=false
BILLING_GATE_ENFORCE=false

# Messaging OIDC configuration for preview environment
MESSAGING_OIDC_ISSUER=https://login.astropods.com
MESSAGING_OIDC_AUTH_ENDPOINT=https://login.astropods.com/oauth2/authorize
MESSAGING_OIDC_TOKEN_ENDPOINT=https://login.astropods.com/oauth2/token
MESSAGING_OIDC_USERINFO_ENDPOINT=https://login.astropods.com/oauth2/userinfo

# Messaging sidecar image for prod. Read by astro-server (MESSAGING_IMAGE) and
# baked into each generated agent deployment spec. Pinned to an immutable digest
# so prod does not silently follow a moving Docker Hub :latest. Bump this via the
# "Promote messaging to prod" workflow, which resolves the current
# astropods/messaging:latest digest and opens a PR replacing the value below.
# Preview intentionally omits this key so it keeps tracking :latest.
MESSAGING_IMAGE=astropods/messaging@sha256:3dc3505f7b89fab05ab216d57083224a93b7e472f480ce7ae5c436fbc61885d0


# Novu configuration
# NOVU_API_URL=https://api.novu.astroids.ai
# NOVU_SOCKET_URL=https://ws.novu.astroids.ai
# NOVU_APP_IDENTIFIER=HhQ3SuEIvdgU
# NOVU_TEST_WORKFLOW_ID=system.test
