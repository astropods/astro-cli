  "$id": "https://astropods.com/schema/package.json",
  "properties": {
    "spec": {
      "type": "string",
      "description": "Spec version. Must be package/v1"
    },
    "name": {
      "type": "string",
      "description": "Unique agent name"
    },
    "meta": {
      "properties": {
        "visibility": {
          "type": "string",
          "enum": [
            "public",
            "private"
          ],
          "description": "Agent visibility: public or private"
        }
      },
      "additionalProperties": false,
      "type": "object"
    },
    "agent": {
      "properties": {
        "image": {
          "type": "string"
        },
        "build": {
          "properties": {
            "context": {
              "type": "string"
            },
            "dockerfile": {
              "type": "string"
            },
            "target": {
              "type": "string"
            },
            "args": {
              "additionalProperties": {
                "type": "string"
              },
              "type": "object"
            },
            "secrets": {
              "items": {
                "properties": {
                  "id": {
                    "type": "string"
                  },
                  "env": {
                    "type": "string"
                  }
                },
                "additionalProperties": false,
                "type": "object",
                "required": [
                  "id"
                ]
              },
              "type": "array"
            }
          },
          "additionalProperties": false,
          "type": "object",
          "required": [
            "context",
            "dockerfile"
          ]
        },
        "distributed": {
          "type": "boolean",
          "description": "Whether the agent supports multi-replica deployment"
        },
        "interfaces": {
          "properties": {
            "frontend": {
              "type": "boolean",
              "description": "Agent serves its own web interface on port 80"
            },
            "messaging": {
              "type": "boolean",
              "description": "Agent supports the messaging protocol"
            }
          },
          "additionalProperties": false,
          "type": "object",
          "description": "Agent capabilities: frontend and/or messaging"
        },
        "healthcheck": {
          "properties": {
            "test": {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "path": {
              "type": "string"
            },
            "interval": {
              "type": "string"
            },
            "timeout": {
              "type": "string"
            },
            "retries": {
              "type": "integer"
            }
          },
          "additionalProperties": false,
          "type": "object"
        },
        "inputs": {
          "items": {
            "properties": {
              "name": {
                "type": "string",
                "description": "Env var key injected into the target container"
              },
              "datatype": {
                "type": "string",
                "enum": [
                  "string",
                  "boolean",
                  "number",
                  "array",
                  "object"
                ],
                "description": "Value type"
              },
              "secret": {
                "type": "boolean",
                "description": "If true"
              },
              "description": {
                "type": "string"
              },
              "display-as": {
                "type": "string",
                "enum": [
                  "short-text",
                  "long-text",
                  "select"
                ],
                "description": "UI rendering hint"
              },
              "options": {
                "items": {
                  "type": "string"
                },
                "type": "array",
                "description": "Allowed values; required when display-as is select"
              },
              "default": {
                "type": "string"
              },
              "optional": {
                "type": "boolean",
                "description": "If true"
              }
            },
            "additionalProperties": false,
            "type": "object",
            "required": [
              "name",
              "datatype"
            ]
          },
          "type": "array",
          "description": "User-supplied inputs injected into the agent container"
        },
        "ai_gateway": {
          "type": "boolean",
          "description": "Enable Astro AI Gateway access (injects ASTRO_GATEWAY_URL and ASTRO_GATEWAY_API_KEY)"
        }
