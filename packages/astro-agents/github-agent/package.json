{
  "name": "github-agent",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Example GitHub agent using Astro workflows",
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "setup": "bun setup-env.ts",
    "playground": "bun --env-file=.env dev/playground.ts"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/postman-eng/astro.git",
    "directory": "packages/astro-agents/github-agent"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.32.1",
    "@saswatds/astro-engine": "workspace:*",
    "@saswatds/astro-graph": "workspace:*",
    "@saswatds/astro-nodes": "workspace:*",
    "@saswatds/astro-types": "workspace:*",
    "@saswatds/astro-agent": "workspace:*",
    "@saswatds/astro-workflows": "workspace:*"
  },
  "devDependencies": {
    "@types/bun": "^1.1.14",
    "@saswatds/astro-playground": "workspace:*",
    "mastra": "^1.0.0-beta.14",
    "typescript": "^5.9.3"
  }
}
