{
  "name": "github-agent",
  "version": "1.0.0",
  "type": "module",
  "description": "Example GitHub agent using Astro workflows",
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "setup": "bun setup-env.ts",
    "playground": "bun --env-file=.env dev/playground.ts"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.32.1",
    "astro-engine": "workspace:*",
    "astro-graph": "workspace:*",
    "astro-nodes": "workspace:*",
    "astro-types": "workspace:*",
    "astro-agent": "workspace:*",
    "astro-workflows": "workspace:*"
  },
  "devDependencies": {
    "@types/bun": "^1.1.14",
    "astro-playground": "workspace:*",
    "mastra": "^1.0.0-beta.14",
    "typescript": "^5.9.3"
  }
}