+// ============================================================================
+// Config Field Types
+// ============================================================================
+
+/**
+ * Configuration field types for user-facing config UI.
+ */
+export type ConfigFieldType =
+  | "short_text"
+  | "long_text"
+  | "select"
+  | "switch"
+  | "secret"
+  | "number";
+
+/**
+ * Base config field definition with common properties.
+ */
+type BaseConfigField = {
+  label?: string;
+  description?: string;
+  required?: boolean;
+};
+
+/**
+ * Short text input field (single line).
+ */
+export type ShortTextField = BaseConfigField & {
+  type: "short_text";
+  default?: string;
+};
+
+/**
+ * Long text input field (multi-line textarea).
+ */
+export type LongTextField = BaseConfigField & {
+  type: "long_text";
+  default?: string;
+};
+
+/**
+ * A single option in a select dropdown.
+ */
+export type SelectOption<TValue extends string = string> = {
+  value: TValue;
+  label: string;
+};
+
+/**
+ * Select dropdown field with predefined options.
+ */
+export type SelectField<
+  TOptions extends readonly SelectOption[] = readonly SelectOption[]
+> = BaseConfigField & {
+  type: "select";
+  options: TOptions;
+  default?: TOptions[number]["value"];
+};
+
+/**
+ * Boolean toggle switch field.
+ */
+export type SwitchField = BaseConfigField & {
+  type: "switch";
+  default?: boolean;
+};
+
+/**
+ * Secret text input field (for passwords, API keys, etc.).
+ */
+export type SecretField = BaseConfigField & {
+  type: "secret";
+  default?: string;
+};
+
+/**
+ * Number input field.
+ */
+export type NumberField = BaseConfigField & {
+  type: "number";
+  default?: number;
+};
+
+/**
+ * Union of all config field definitions.
+ */
+export type ConfigFieldDefinition =
+  | ShortTextField
+  | LongTextField
+  | SelectField
+  | SwitchField
+  | SecretField
+  | NumberField;
+
+/**
+ * A record of config field definitions.
+ */
+export type ConfigDefinitions = Record<string, ConfigFieldDefinition>;
+
+/**
+ * Map from config field type to its runtime value type.
+ * Add new field types here to extend the config system.
+ */
+type ConfigFieldValueMap = {
+  short_text: string;
+  long_text: string;
+  switch: boolean;
+  secret: string;
+  number: number;
+  // Note: 'select' is handled specially to extract literal option types
+};
