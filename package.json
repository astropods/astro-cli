{
  "name": "astro",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "moon run :build --query \"language=typescript AND projectType=library\"",
    "clean": "rm -rf packages/astro-types/dist packages/astro-nodes/dist packages/astro-engine/dist packages/astro-graph/dist packages/astro-workflows/dist packages/astro-agent/dist packages/astro-playground/dist",
    "publish:all": "./scripts/publish-all.sh",
    "publish:affected": "./scripts/publish-affected.sh",
    "release": "./scripts/publish-affected.sh --since-tag",
    "release:dry": "./scripts/publish-affected.sh --since-tag --dry-run"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/postman-eng/astro.git"
  },
  "dependencies": {
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "typescript": "^5.3.0"
  }
}
