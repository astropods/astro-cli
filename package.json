{
  "name": "astro",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "moon run :build --query \"language=typescript AND projectType=library\"",
    "typecheck": "moon run :typecheck --query \"language=typescript\"",
    "clean": "moon run :clean --query \"language=typescript AND projectType=library\"",
    "release": "bun scripts/release.ts",
    "release:dry": "bun scripts/release.ts --dry-run"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/postman-eng/astro.git"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.91.0",
    "@assistant-ui/react": "^0.14.14",
    "@assistant-ui/react-markdown": "^0.14.1",
    "quansync": "^0.2.11",
    "sonner": "^2.0.7",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@moonrepo/cli": "^1",
    "@playwright/test": "^1.49.0",
    "@types/bun": "latest",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "typescript": "^5.3.0"
  },
  "module": "index.ts",
  "type": "module"
}
