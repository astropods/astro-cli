{
  "name": "astro",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "packages/astro-agents/*",
    "apps/*"
  ],
  "scripts": {
    "build": "moon run :build --query \"language=typescript AND projectType=library\"",
    "typecheck": "moon run :typecheck --query \"language=typescript\"",
    "clean": "moon run :clean --query \"language=typescript AND projectType=library\"",
    "release": "bun scripts/release.ts",
    "release:dry": "bun scripts/release.ts --dry-run"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/postman-eng/astro.git"
  },
  "dependencies": {
    "quansync": "^0.2.11",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@moonrepo/cli": "^1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "typescript": "^5.3.0"
  }
}
