# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Output of the go coverage tool
*.out

# Go workspace file
go.work

# Built binary
astro-cli
astro
ast
/bin/
/dist/

# Vendored deps (generated by moon task vendor)
vendor/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Environment files with secrets
.env
.env.local

# Credentials
.secrets/

# Embedded chat UI assets are built from astro-client and copied in at build
# time; only the .gitkeep placeholder is tracked.
internal/chatui/webdist/*
!internal/chatui/webdist/.gitkeep
