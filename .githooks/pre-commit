#!/usr/bin/env sh
set -e

# Run gofmt on staged Go files
STAGED_GO=$(git diff --cached --name-only --diff-filter=ACM | grep '\.go$' || true)
if [ -n "$STAGED_GO" ]; then
  UNFORMATTED=$(echo "$STAGED_GO" | xargs gofmt -l 2>/dev/null || true)
  if [ -n "$UNFORMATTED" ]; then
    echo "gofmt: auto-fixing formatting..."
    echo "$UNFORMATTED" | xargs gofmt -w
    echo "$UNFORMATTED" | xargs git add
  fi
fi
